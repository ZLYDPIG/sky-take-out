<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<!--
  EmployeeMapper 的 XML 映射文件。
  说明：本文件必须保留 <mapper> 根标签，否则 MyBatis 解析时会报
        “SAXParseException: 文件提前结束”，导致 sqlSessionFactory 创建失败、项目启动不了。
  namespace 必须与 com.sky.mapper.EmployeeMapper 接口的全限定名完全一致。
  目前 EmployeeMapper 里的查询用 @Select 注解写在接口上，所以这里暂时没有 <select> 语句。
-->
<mapper namespace="com.sky.mapper.EmployeeMapper">

    <select id="pageQuery" resultType="com.sky.entity.Employee">
        select * from employee
        <where>
            <if test="name != null and name != ''">
                name like concat('%', #{name}, '%')
            </if>
        </where>
    </select>

</mapper>
